    "LICENSE",
    "screenshots.json",
    "preview.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gold",
    "gold-price",
    "finance",
    "market",
    "sge",
    "shfe"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
